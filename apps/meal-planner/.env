NODE_ENV=production
PORT=3001
# cluster-specific: NETWORK_HOSTNAME_SUFFIX
CLIENT_URL=https://meals.themartinez.cloud
# cluster-specific: NETWORK_HOSTNAME_SUFFIX
GOOGLE_CALLBACK_URL=https://meals.themartinez.cloud/api/auth/google/callback
IMAGE_STORAGE_ROOT=/data/images
# socket.io Redis adapter → multi-replica realtime fan-out (v1.0.312, PR #216).
# Shared platform Redis; unset would fall back to the in-memory adapter, which
# breaks WebSocket rooms across the 2-3 HPA replicas.
REDIS_URL=redis://redis.redis.svc.cluster.local:6379
